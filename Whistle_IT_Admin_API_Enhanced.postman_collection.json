									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        console.log('✅ Admin signup successful!');",
									"        console.log('📧 Check your email for verification token');",
									"        console.log('👤 Admin:', response.admin.name);",
									"    }",
									"} else {",
									"    console.log('❌ Signup failed:', pm.response.text());",
									"}"
