				{
					"name": "5️⃣ Password Reset Completion Success",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const resetToken = pm.environment.get('admin_reset_token');",
									"if (!resetToken) {",
									"    const dummyResetToken = 'test_reset_token_' + Date.now();",
									"    pm.environment.set('admin_reset_token', dummyResetToken);",
									"}",
									"const newPassword = 'NewSecurePass' + Date.now() + '!@#';",
									"pm.environment.set('new_admin_password', newPassword);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.test('Password reset successful', () => {",
									"        const jsonData = pm.response.json();",
									"        pm.expect(jsonData.success).to.equal(true);",
									"        pm.expect(jsonData.message).to.include('reset successfully');",
									"    });",
									"    const newPassword = pm.environment.get('new_admin_password');",
									"    pm.environment.set('test_admin_password', newPassword);",
									"    pm.environment.unset('admin_access_token');",
									"    console.log('✅ Password reset successful - Updated credentials');",
									"} else {",
									"    console.log('ℹ️ Password reset may require real token from email');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Accept", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"{{admin_reset_token}}\",\n    \"password\": \"{{new_admin_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/auth/reset-password",
							"host": ["{{base_url}}"],
							"path": ["admin", "auth", "reset-password"]
						}
					}
				},
				{
					"name": "6️⃣ Admin Logout Success",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    pm.test('Logout successful', () => {",
									"        const jsonData = pm.response.json();",
									"        pm.expect(jsonData.success).to.equal(true);",
									"        pm.expect(jsonData.message).to.include('Logout successful');",
									"    });",
									"    pm.environment.unset('admin_access_token');",
									"    pm.environment.unset('authentication_success');",
									"    console.log('✅ Logout successful - Tokens cleared');",
									"} else {",
									"    console.log('ℹ️ Logout may require valid token');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Accept", "value": "application/json"},
							{"key": "Authorization", "value": "Bearer {{admin_access_token}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/admin/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["admin", "auth", "logout"]
						}
					}
				}
			]
		}
