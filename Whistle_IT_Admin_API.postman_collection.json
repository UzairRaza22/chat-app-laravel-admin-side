				{
					"name": "3. Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login should return 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.access_token) {",
									"        pm.environment.set('admin_token', response.access_token);",
									"        console.log('✅ Admin login successful!');",
									"        console.log('🔑 Admin token saved:', response.access_token.substring(0, 20) + '...');",
									"        console.log('👤 Admin:', response.admin.name);",
									"        console.log('✅ Ready to test admin operations!');",
									"    }",
									"} else {",
									"    console.log('❌ Login failed:', pm.response.text());",
									"}"
								],
