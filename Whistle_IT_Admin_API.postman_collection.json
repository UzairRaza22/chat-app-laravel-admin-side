				{
					"name": "1. Admin Signup",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Signup should return 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response should have success true', function () {",
									"    const response = pm.response.json();",
									"    pm.expect(response.success).to.be.true;",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    console.log('✅ Admin signup successful!');",
									"    console.log('📧 Check your email for verification token');",
									"    console.log('👤 Admin:', response.admin.name);",
									"} else {",
									"    console.log('❌ Signup failed:', pm.response.text());",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
