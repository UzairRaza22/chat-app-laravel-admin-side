{
  "info": {
    "_postman_id": "telescope-testing-suite",
    "name": "Telescope Testing Suite",
    "description": "Complete testing suite for monitoring API with Laravel Telescope",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1️⃣ Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/up",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["up"]
        },
        "description": "Test basic health check endpoint - no authentication needed"
      },
      "response": []
    },
    {
      "name": "2️⃣ API Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/api/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "health"]
        },
        "description": "Test API health endpoint"
      },
      "response": []
    },
    {
      "name": "3️⃣ Admin Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"your_admin_email@example.com\",\n  \"password\": \"your_admin_password\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/admin/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "login"]
        },
        "description": "LOGIN FIRST! Save the token from response.\nReplace email/password with your admin credentials."
      },
      "response": []
    },
    {
      "name": "4️⃣ Read Users (Valid Token)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/admin/users/read?page=1&per_page=10",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "users", "read"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "per_page",
              "value": "10"
            }
          ]
        },
        "description": "Read users - requires valid admin token from Test 3\nWatch in Telescope: Requests tab → Queries tab"
      },
      "response": []
    },
    {
      "name": "5️⃣ Read Users (No Token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/api/admin/users/read",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "users", "read"]
        },
        "description": "Test without token - should get 401 Unauthorized\nWatch in Telescope: See request rejected in 5ms"
      },
      "response": []
    },
    {
      "name": "6️⃣ Read Users (Invalid Token)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid_token_xyz_123",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/admin/users/read",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "users", "read"]
        },
        "description": "Test with invalid token - should get 401\nWatch in Telescope: Exceptions tab"
      },
      "response": []
    },
    {
      "name": "7️⃣ Read Users (Large Page)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/admin/users/read?page=1&per_page=100",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "users", "read"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "per_page",
              "value": "100"
            }
          ]
        },
        "description": "Load large dataset - watch for N+1 problems in Telescope Queries tab"
      },
      "response": []
    },
    {
      "name": "8️⃣ Validation Error (Invalid Params)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/admin/users/read?per_page=invalid&page=abc",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "users", "read"],
          "query": [
            {
              "key": "per_page",
              "value": "invalid"
            },
            {
              "key": "page",
              "value": "abc"
            }
          ]
        },
        "description": "Test validation - should get 422 Unprocessable Entity\nWatch in Telescope: Exceptions tab"
      },
      "response": []
    },
    {
      "name": "9️⃣ Read Workspaces",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/admin/workspaces/read",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "workspaces", "read"]
        },
        "description": "Read workspaces - try different endpoints to see patterns"
      },
      "response": []
    },
    {
      "name": "🔟 Read Teams",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/admin/teams/read",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "teams", "read"]
        },
        "description": "Read teams"
      },
      "response": []
    },
    {
      "name": "1️⃣1️⃣ Generate Impersonation Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/admin/impersonate/read?user_id=REPLACE_WITH_REAL_USER_ID",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "admin", "impersonate", "read"],
          "query": [
            {
              "key": "user_id",
              "value": "REPLACE_WITH_REAL_USER_ID"
            }
          ]
        },
        "description": "Generate impersonation token for a user\n\nIMPORTANT: Replace REPLACE_WITH_REAL_USER_ID with actual MongoDB user ID\nThen copy the 'token' from response and use in Test 12"
      },
      "response": []
    },
    {
      "name": "1️⃣2️⃣ Use Impersonation Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Impersonation-Token",
            "value": "{{impersonation_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/impersonate/dashboard",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "impersonate", "dashboard"]
        },
        "description": "Access dashboard as impersonated user\nUse token from Test 11 response"
      },
      "response": []
    },
    {
      "name": "1️⃣3️⃣ Impersonated User Data",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Impersonation-Token",
            "value": "{{impersonation_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/impersonate/profile",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "impersonate", "profile"]
        },
        "description": "Get profile of impersonated user"
      },
      "response": []
    },
    {
      "name": "1️⃣4️⃣ Impersonated Workspaces",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Impersonation-Token",
            "value": "{{impersonation_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/impersonate/workspaces",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "impersonate", "workspaces"]
        },
        "description": "Get workspaces of impersonated user"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "admin_token",
      "value": "PASTE_TOKEN_FROM_TEST_3_HERE",
      "type": "string"
    },
    {
      "key": "impersonation_token",
      "value": "PASTE_TOKEN_FROM_TEST_11_HERE",
      "type": "string"
    }
  ]
}
